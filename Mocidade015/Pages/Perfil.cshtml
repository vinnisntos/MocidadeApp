@page
@model Mocidade015.Pages.App.PerfilModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="card-elevated shadow-md p-4 p-lg-5">
            <div class="text-center mb-4">
                <div class="avatar avatar--lg mb-3 mx-auto" aria-hidden="true">
                    <i class="bi bi-person-fill"></i>
                </div>
                <h1 class="h4 fw-bold text-brand mb-1">Dados Pessoais</h1>
                <p class="text-muted small mb-0">Mantenha seus dados de contato atualizados</p>
            </div>

            @if (TempData["Mensagem"] != null)
            {
                <div class="alert alert-success small mb-4">@TempData["Mensagem"]</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Nome Completo</label>
                    <input asp-for="Input.Nome" class="form-control" placeholder="Seu nome" required />
                    <span asp-validation-for="Input.Nome" class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <div class="input-group-icon">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Input.Email" class="form-control" placeholder="seu@email.com" required />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Seu RG ou CPF</label>
                    <input asp-for="Input.Rg" class="form-control" placeholder="00.000.000-0" required />
                    <span asp-validation-for="Input.Rg" class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Telefone</label>
                    <input asp-for="Input.Telefone" class="form-control" placeholder="(15) 99999-9999" />
                    <span asp-validation-for="Input.Telefone" class="field-error"></span>
                </div>

                <div class="divider"></div>

                <div class="mb-3">
                    <label class="form-label text-danger">Nova Senha (deixe em branco para não alterar)</label>
                    <div class="input-group-icon">
                        <i class="bi bi-key"></i>
                        <input asp-for="Input.NovaSenha" type="password" class="form-control" placeholder="••••••••" />
                    </div>
                </div>

                <button type="submit" class="btn btn-brand w-100 mt-2">
                    <i class="bi bi-check-lg me-1"></i> Salvar Alterações
                </button>
            </form>
        </div>

        <div class="text-center mt-3">
            <a asp-page="/App/Dashboard" class="btn-link-quiet small text-decoration-none">
                <i class="bi bi-arrow-left"></i> Voltar ao Dashboard
            </a>
        </div>
    </div>
</div>
