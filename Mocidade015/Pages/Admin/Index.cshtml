@page
@model Mocidade015.Pages.Admin.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestão de Embarque";
    ViewData["FullWidth"] = true;
}

<div class="admin-shell mt-2 mt-lg-3">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-brand m-0">Painel Administrativo</h2>
            <p class="text-muted small m-0">Gerencie passageiros e lista de espera</p>
        </div>
        <button onclick="window.print()" class="btn btn-outline-brand d-print-none text-nowrap">
            <i class="bi bi-printer"></i> Imprimir Listas
        </button>
    </div>

    @if (TempData["Mensagem"] != null)
    {
        <div class="alert alert-success">@TempData["Mensagem"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }

    @* SEÇÃO 1: RESUMO DE DEMANDA (BARRINHAS) *@
    <div class="mt-4 mb-5 d-print-none">
        <h4 class="fw-bold text-brand mb-3"><i class="bi bi-hourglass-split me-2"></i>Resumo de Demanda (Lista de Espera)</h4>
        <div class="card-grid">
            @foreach (var resumo in Model.ResumoEspera)
            {
                var capRef = 44; // Referência de um ônibus padrão
                var porcentagem = (resumo.Total * 100) / capRef;
                var corBarra = resumo.Total >= capRef ? "progress-modern__bar--danger" : (resumo.Total >= 20 ? "progress-modern__bar--warning" : "progress-modern__bar--info");

                <div class="card-elevated stat-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-brand text-truncate">
                            <i class="bi bi-geo-alt-fill text-accent me-1"></i>@resumo.Terminal
                        </span>
                        <span class="pill pill--brand">@resumo.Total pessoas</span>
                    </div>
                    <div class="progress-modern">
                        <div class="progress-modern__bar @corBarra"
                             style="width: @(porcentagem > 100 ? 100 : porcentagem)%;">
                        </div>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        @(capRef - resumo.Total > 0 ? $"Faltam {capRef - resumo.Total} para um novo ônibus" : "Demanda crítica! Analisar novo fretamento.")
                    </small>
                </div>
            }
        </div>
    </div>

    @* SEÇÃO 2: RELATÓRIO DOS ÔNIBUS *@
    <div class="card-grid card-grid--wide mb-5">
        @foreach (var onibus in Model.RelatorioOnibus)
        {
            <div class="card-elevated card-elevated--lg overflow-hidden d-flex flex-column">
                <div class="table-card__header flex-wrap gap-2">
                    <span class="fw-bold"><i class="bi bi-bus-front me-2"></i>Ônibus #@onibus.Numero - @onibus.Terminal</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @(onibus.TotalOcupados >= onibus.LotacaoMaxima ? "bg-danger" : "bg-success")">
                            @onibus.TotalOcupados / @onibus.LotacaoMaxima Ocupados
                        </span>
                        <button class="btn btn-outline-light btn-sm border-0 d-print-none" type="button"
                                data-bs-toggle="collapse" data-bs-target="#mapa-@onibus.Id" title="Ver mapa de assentos">
                            <i class="bi bi-grid-3x3-gap"></i> Mapa
                        </button>
                        <form method="post" asp-page-handler="GerarNovoOnibus" asp-route-terminal="@onibus.Terminal"
                              onsubmit="return confirm('Confirma a criação de um novo ônibus para @onibus.Terminal? Essa ação deve refletir uma decisão real de fretamento.');" class="d-inline d-print-none">
                            <button class="btn btn-outline-light btn-sm border-0" title="Gerar novo ônibus para este terminal">
                                <i class="bi bi-plus-circle"></i> Novo ônibus
                            </button>
                        </form>
                    </div>
                </div>

                @* MAPA VISUAL DE ASSENTOS - permite atribuir vaga da espera a um assento vago *@
                <div class="collapse d-print-none" id="mapa-@onibus.Id">
                    <div class="p-3 p-lg-4 border-bottom surface-muted">
                        <div class="seat-grid">
                            @foreach (var assento in onibus.Assentos)
                            {
                                var nomeOcupante = onibus.NomesPorAssentoId.GetValueOrDefault(assento.Id);
                                if (assento.Ocupado || !string.IsNullOrEmpty(nomeOcupante))
                                {
                                    <button class="seat seat--occupied" disabled title="@(nomeOcupante ?? "Ocupado")">
                                        @assento.Numero
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="seat" title="Assento vago - clique para atribuir"
                                            data-bs-toggle="modal" data-bs-target="#modalAtribuir-@onibus.Id"
                                            onclick="document.getElementById('assentoIdInput-@onibus.Id').value='@assento.Id'; document.getElementById('assentoNumeroLabel-@onibus.Id').textContent='@assento.Numero';">
                                        @assento.Numero
                                    </button>
                                }
                            }
                        </div>
                        <div class="mt-3 d-flex justify-content-center gap-4 text-muted small">
                            <span><i class="bi bi-square-fill text-soft"></i> Ocupado</span>
                            <span><i class="bi bi-square text-brand"></i> Vago (clique para atribuir vaga da espera)</span>
                        </div>
                    </div>
                </div>

                @* MODAL: atribuir vaga da lista de espera ao assento clicado *@
                <div class="modal fade" id="modalAtribuir-@onibus.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content rounded-4">
                            <form method="post" asp-page-handler="AtribuirVaga">
                                <div class="modal-header">
                                    <h5 class="modal-title">Atribuir assento <span id="assentoNumeroLabel-@onibus.Id"></span></h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="assentoId" id="assentoIdInput-@onibus.Id" value="" />
                                    @if (!onibus.FilaEsperaDoTerminal.Any())
                                    {
                                        <p class="text-muted mb-0">Não há ninguém na lista de espera para @onibus.Terminal.</p>
                                    }
                                    else
                                    {
                                        <label class="form-label fw-semibold">Escolha quem entra nesta vaga:</label>
                                        <select name="esperaId" class="form-select" required>
                                            @foreach (var espera in onibus.FilaEsperaDoTerminal)
                                            {
                                                <option value="@espera.Id">@espera.Usuario?.Nome (esperando desde @espera.DataSolicitacao.ToString("dd/MM HH:mm"))</option>
                                            }
                                        </select>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                                    @if (onibus.FilaEsperaDoTerminal.Any())
                                    {
                                        <button type="submit" class="btn btn-brand">
                                            <i class="bi bi-person-check"></i> Atribuir vaga
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="table-card__scroll flex-grow-1">
                    <table class="table-clean">
                        <thead>
                            <tr>
                                <th>Poltrona</th>
                                <th>Passageiro</th>
                                <th>Documento</th>
                                <th>Telefone</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in onibus.Reservas)
                            {
                                <tr>
                                    <td class="fw-bold">#@r.Assento.Numero.ToString("D2")</td>
                                    <td>
                                        <span class="d-block fw-semibold text-truncate" style="max-width: 200px;">
                                            @(r.Acompanhante?.Nome ?? r.Usuario.Nome)
                                        </span>
                                        <small class="text-muted">@(r.AcompanhanteId == null ? "Titular" : "Acompanhante")</small>
                                    </td>
                                    <td class="small text-nowrap">@(r.Acompanhante?.RgCpf ?? r.Usuario.Rg)</td>
                                    <td class="small text-nowrap">@(r.Acompanhante?.Telefone ?? r.Usuario.Telefone ?? "-")</td>
                                    <td class="text-center">
                                        <form method="post" asp-page-handler="CancelarReserva" asp-route-reservaId="@r.Id"
                                              onsubmit="return confirm('Liberar assento?');" class="d-inline">
                                            <button class="btn-icon-danger" title="Remover Passageiro">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @* SEÇÃO 3: TABELA DETALHADA DA LISTA DE ESPERA *@
    <div class="mt-5 d-print-none">
        <h4 class="fw-bold text-brand mb-3"><i class="bi bi-clipboard2-check me-2"></i>Detalhes da Fila</h4>
        <div class="table-card">
            <div class="table-card__scroll">
                <table class="table-clean">
                    <thead>
                        <tr>
                            <th>Solicitante</th>
                            <th>Telefone</th>
                            <th>Terminal</th>
                            <th>Data/Hora</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.FilaEspera.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">Fila vazia.</td></tr>
                        }
                        @foreach (var espera in Model.FilaEspera)
                        {
                            <tr>
                                <td class="fw-bold">@espera.Usuario?.Nome</td>
                                <td class="text-nowrap">@(espera.Usuario?.Telefone ?? "-")</td>
                                <td><span class="pill pill--accent">@espera.TerminalDesejado</span></td>
                                <td class="small text-muted text-nowrap">@espera.DataSolicitacao.ToString("dd/MM HH:mm")</td>
                                <td class="text-center">
                                    <form method="post" asp-page-handler="RemoverDaEspera" asp-route-esperaId="@espera.Id"
                                          onsubmit="return confirm('Remover da lista?');">
                                        <button class="btn-icon-danger" title="Remover da Espera">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
