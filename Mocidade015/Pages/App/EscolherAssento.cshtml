@page "{onibusId:guid}"
@model Mocidade015.Pages.App.EscolherAssentoModel
@{
    ViewData["Title"] = "Escolha sua Poltrona";
}

<div class="text-center mb-4">
    <h4 class="fw-bold text-brand">Selecione o assento para:</h4>
    <span class="pill pill--brand mt-1"><i class="bi bi-person-fill"></i> @Model.NomePassageiro</span>
</div>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger text-center mb-4">
        @TempData["Erro"]
    </div>
}

<div class="bus">
    <div class="bus__front">
        <span class="icon-pill"><i class="bi bi-steering-wheel"></i></span>
        <small class="text-muted fw-bold">FRENTE DO ÔNIBUS</small>
    </div>

    @{
        var linhas = Model.Assentos
            .Select((assento, indice) => new { assento, indice })
            .GroupBy(x => x.indice / 4)
            .Select(g => g.Select(x => x.assento).ToList())
            .ToList();
    }

    @foreach (var linha in linhas)
    {
        <div class="bus__row">
            @for (int pos = 0; pos < 4; pos++)
            {
                if (pos == 2)
                {
                    <div class="bus__corridor"></div>
                }

                var assento = linha.ElementAtOrDefault(pos);

                if (assento == null)
                {
                    <div></div>
                }
                else if (Model.AssentoAtualId == assento.Id)
                {
                    <button class="seat seat--mine" disabled title="Este é o seu assento atual">@assento.Numero</button>
                }
                else if (Model.AssentosOcupadosIds.Contains(assento.Id))
                {
                    <button class="seat seat--occupied" disabled title="Assento indisponível">@assento.Numero</button>
                }
                else
                {
                    <form method="post" class="form-contents">
                        <input type="hidden" name="assentoId" value="@assento.Id" />
                        <input type="hidden" name="onibusId" value="@Model.Onibus.Id" />
                        <input type="hidden" name="acompanhanteId" value="@Model.AcompanhanteId" />
                        <button type="submit" class="seat" title="Assento livre">@assento.Numero</button>
                    </form>
                }
            }
        </div>
    }

    <div class="bus__legend">
        <span><i class="bi bi-square-fill text-success"></i> Seu Lugar</span>
        <span><i class="bi bi-square-fill text-soft"></i> Ocupado</span>
        <span><i class="bi bi-square text-brand"></i> Livre</span>
    </div>

    <div class="divider"></div>

    <div class="text-center">
        <p class="text-muted small mb-2">As poltronas restantes não agradam?</p>
        <a href="/App/ListaEspera?terminal=@Model.Onibus.TerminalSaida" class="btn btn-accent w-100">
            <i class="bi bi-clock-history"></i> Entrar na Lista de Espera
        </a>
    </div>
</div>
