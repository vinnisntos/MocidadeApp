@page
@model Mocidade015.Pages.App.ListaEsperaModel
@{
    ViewData["Title"] = "Entrar na Lista de Espera";
}

<div class="narrow-card text-center">
    <div class="card-elevated shadow-md p-4 p-lg-5">
        <i class="bi bi-clock-history icon-xl text-warning"></i>
        <h2 class="fw-bold text-brand mt-3">Lista de Espera</h2>

        <p class="text-muted mt-3">
            Olá, <strong>@Model.NomeUsuario</strong>!<br>
            Você está entrando na lista de espera para o destino:<br>
            <span class="pill pill--brand mt-2">📍 @Model.Terminal</span>
        </p>

        <form method="post" class="mt-4">
            <input type="hidden" asp-for="Terminal" />

            <button type="submit" class="btn btn-accent w-100 mb-3">
                <i class="bi bi-check-lg"></i> Confirmar meu nome na lista
            </button>

            <a href="/App/Dashboard" class="btn btn-ghost w-100">Cancelar e voltar</a>
        </form>
    </div>
</div>
