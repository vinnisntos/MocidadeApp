@page
@model Mocidade015.Pages.App.AcompanhantesModel
@{
    ViewData["Title"] = "Meus Acompanhantes";
}

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card-elevated shadow-md p-4">
            <h5 class="fw-bold text-brand mb-3">Novo Acompanhante</h5>
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Nome Completo</label>
                    <input asp-for="NovoAcompanhante.Nome" class="form-control" placeholder="Nome do passageiro" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">RG ou CPF</label>
                    <input asp-for="NovoAcompanhante.RgCpf" class="form-control" placeholder="00.000.000-0" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Telefone</label>
                    <input asp-for="NovoAcompanhante.Telefone" class="form-control" placeholder="(15) 99999-9999" />
                </div>
                <button type="submit" class="btn btn-brand w-100">
                    <i class="bi bi-person-plus me-1"></i> Cadastrar
                </button>
            </form>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card-elevated shadow-md p-4">
            <h5 class="fw-bold text-brand mb-3">Pessoas Cadastradas</h5>

            @if (!Model.ListaAcompanhantes.Any())
            {
                <div class="empty-state py-4">
                    <div class="icon"><i class="bi bi-people"></i></div>
                    <p class="mt-2 mb-0 small">Você ainda não cadastrou nenhum acompanhante.</p>
                </div>
            }
            else
            {
                <div class="list-card">
                    @foreach (var item in Model.ListaAcompanhantes)
                    {
                        <div class="list-card__item justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <span class="list-card__icon"><i class="bi bi-person"></i></span>
                                <div>
                                    <h6 class="mb-0 fw-bold">@item.Nome</h6>
                                    <small class="text-muted">Doc: @item.RgCpf | Tel: @(item.Telefone ?? "Não informado")</small>
                                </div>
                            </div>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id">
                                <button class="btn-icon-danger" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="mt-3">
            <a asp-page="/App/Dashboard" class="btn-link-quiet small text-decoration-none">
                <i class="bi bi-arrow-left"></i> Voltar para o Dashboard
            </a>
        </div>
    </div>
</div>
