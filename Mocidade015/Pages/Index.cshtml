@page
@model Mocidade015.Pages.IndexModel
@{
    ViewData["Title"] = "Página Inicial";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="hero text-center mb-4">
            <span class="icon-hero" aria-hidden="true">🚌</span>
            <h1 class="fw-bold mt-2">Bem-vindo à Mocidade 015!</h1>
            <p class="mb-0">
                Garanta sua passagem para a viagem do dia <strong>26/07</strong> de forma rápida e segura.<br />
                Escolha seu ônibus e selecione sua poltrona em poucos cliques.
            </p>
        </div>

        <div class="card-elevated shadow-md p-4 p-lg-5 text-center">
            <div class="d-grid gap-3">
                <a asp-page="/Login" class="btn btn-brand btn-lg">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Fazer Login na sua conta
                </a>
                <a asp-page="/Cadastro" class="btn btn-ghost">
                    Ainda não tem conta? Cadastre-se
                </a>
            </div>
        </div>
    </div>
</div>
